import React, { useCallback, useEffect, useRef, useState } from 'react';
import { PageViewMode } from '@vivliostyle/core';
import { createPortal } from 'react-dom';
import { Renderer } from '@vivliostyle/react';
import { VivlioPayload } from '../hooks/useVivlioBuild';

interface VivlioViewerFrameProps {
  payload: VivlioPayload | null;
  sourceUrl: string | null;
  showRaw: boolean;
  gutterColor: string;
  page: number;
  onRendererLoad: (state: unknown) => void;
  onRendererNavigation?: (state: unknown) => void;
  onReset: () => void;
  viewerReady: boolean;
  isBuilding: boolean;
  pageViewMode?: PageViewMode;
  readingDirection?: 'ltr' | 'rtl';
  pageCount: number | null;
  zoom: number;
  onZoomChange: (newZoom: number) => void;
}

export const VivlioViewerFrame: React.FC<VivlioViewerFrameProps> = ({
  payload,
  sourceUrl,
  showRaw,
  gutterColor,
  page,
  onRendererLoad,
  onRendererNavigation,
  onReset,
  viewerReady,
  isBuilding,
  pageViewMode = PageViewMode.SINGLE_PAGE,
  readingDirection = 'ltr',
  pageCount,
  zoom,
  onZoomChange,
}) => {
  const iframeRef = useRef<HTMLIFrameElement | null>(null);
  const wrapperRef = useRef<HTMLDivElement | null>(null);
  const spacerRef = useRef<HTMLDivElement | null>(null);
  const lastZoomRef = useRef<number>(zoom);
  const [portalContainer, setPortalContainer] = useState<HTMLElement | null>(null);

  const handleIframeLoad = useCallback(() => {
    const iframe = iframeRef.current;
    if (!iframe) return;
    try {
      const doc = iframe.contentDocument || iframe.contentWindow?.document;
      if (!doc) return;
      let mount = doc.getElementById('vivlio-root') as HTMLElement | null;
      if (!mount) {
        mount = doc.createElement('div');
        mount.id = 'vivlio-root';
        doc.body.appendChild(mount);
      }
      setPortalContainer(mount);
      // Don't call onReset here - it would reset page to 1 and break initial load
      // The Renderer will call onRendererLoad when ready, which will sync state
    } catch (e) {
      console.warn('[VivlioDBG] iframe onLoad mount failed', e);
      setPortalContainer(null);
    }
  }, []);  // Remove onReset from dependencies

  useIframeOverlay(portalContainer, page, readingDirection, pageViewMode, zoom, iframeRef);

  // When zoom or content changes, measure the inner content size and set iframe dimensions
  // Transform-only approach:
  // - iframe keeps actual content size (no inner scaling)
  // - a spacer element (spacerRef) provides the scrollable area sized to contentSize * zoom
  // - iframe is positioned absolute and visually scaled via CSS transform
  useEffect(() => {
    const iframe = iframeRef.current;
    const wrapper = wrapperRef.current;
    const spacer = spacerRef.current;
    if (!iframe || !wrapper) return;

    // capture previous scroll ratios (used when not centering on zoom)
    const prev = { leftRatio: 0, topRatio: 0 };
    if (wrapper.scrollWidth > wrapper.clientWidth) {
      prev.leftRatio = wrapper.scrollLeft / Math.max(1, wrapper.scrollWidth - wrapper.clientWidth);
    }
    if (wrapper.scrollHeight > wrapper.clientHeight) {
      prev.topRatio = wrapper.scrollTop / Math.max(1, wrapper.scrollHeight - wrapper.clientHeight);
    }

    // Determine if zoom changed (we should center on zoom change)
    const prevZoom = lastZoomRef.current ?? zoom;
    const zoomChanged = prevZoom !== zoom;
    // compute content-space coordinates of the current viewport center (using prevZoom)
    const vwCenterX = wrapper.scrollLeft + wrapper.clientWidth / 2;
    const vwCenterY = wrapper.scrollTop + wrapper.clientHeight / 2;
    const contentCenterX = vwCenterX / Math.max(0.0001, prevZoom);
    const contentCenterY = vwCenterY / Math.max(0.0001, prevZoom);
    // will hold desired scroll after resize/reflow
    let centerTargetLeft = 0;
    let centerTargetTop = 0;

    try {
      // Try to measure content inside the iframe. Prefer a page/spread container if present.
      const doc = iframe.contentDocument;
      let contentEl: HTMLElement | null = null;
      if (doc) {
        contentEl = doc.querySelector('[data-vivliostyle-spread-container], [data-vivliostyle-page-container], .page') as HTMLElement | null;
        if (!contentEl) contentEl = doc.body;
      }

      let contentWidth = wrapper.clientWidth;
      let contentHeight = wrapper.clientHeight;
      if (contentEl) {
        const rect = contentEl.getBoundingClientRect();
        // rect.width/height are in CSS pixels of the iframe's viewport; use them as base
        contentWidth = Math.max(1, Math.round(rect.width));
        contentHeight = Math.max(1, Math.round(rect.height));
      } else {
        // fallback to iframe client size
        contentWidth = iframe.clientWidth;
        contentHeight = iframe.clientHeight;
      }
      const normalizedCenterX =
        Number.isFinite(contentCenterX) ? contentCenterX : contentWidth / 2;
      const normalizedCenterY =
        Number.isFinite(contentCenterY) ? contentCenterY : contentHeight / 2;
      
      console.log('[VivlioDBG][iframe-measure]', {
        contentWidth,
        contentHeight,
        zoom,
        wrapperClient: { width: wrapper.clientWidth, height: wrapper.clientHeight },
        wrapperScroll: { width: wrapper.scrollWidth, height: wrapper.scrollHeight }
      });
      
      // iframe should have the real content size (so its internal layout matches 1:1)
      iframe.style.width = `${Math.max(1, contentWidth)}px`;
      iframe.style.height = `${Math.max(1, contentHeight)}px`;
      iframe.style.position = 'absolute';
      iframe.style.left = '0';
      iframe.style.top = '0';
      // Always use top left as transform-origin to prevent content from being cut off
      iframe.style.transformOrigin = 'top left';
      iframe.style.transform = `scale(${zoom})`;
      iframe.style.maxWidth = 'none';
      iframe.style.display = 'block';
      
      // spacer drives the scroll area - must account for the visual size after transform
      // When zoom > 1, the iframe visually expands, so spacer must be larger
      const visualWidth = Math.max(1, Math.round(contentWidth * zoom));
      const visualHeight = Math.max(1, Math.round(contentHeight * zoom));
      
      console.log('[VivlioDBG][iframe-spacer]', { visualWidth, visualHeight });
      
      if (spacer) {
        spacer.style.width = `${visualWidth}px`;
        spacer.style.height = `${visualHeight}px`;
      }

      // compute where we want the wrapper to scroll so that the contentCenter
      // remains at the viewport center after applying the new zoom
      if (zoomChanged) {
        // With top-left origin, the scroll offset calculation is straightforward
        // We want to keep the same content point at the viewport center
        centerTargetLeft = Math.round(normalizedCenterX * zoom - wrapper.clientWidth / 2);
        centerTargetTop = Math.round(normalizedCenterY * zoom - wrapper.clientHeight / 2);
      }

  // Force a resize event in the iframe's window so inner renderer recomputes layout
  try { iframe.contentWindow?.dispatchEvent(new Event('resize')); } catch (e) { /* ignore */ }
  // Ask iframe to perform a reflow (its message handler will dispatch resize and notify back)
  try { iframe.contentWindow?.postMessage({ type: 'vivlio:requestReflow' }, '*'); } catch (e) { /* ignore */ }

      // Wait for iframe to acknowledge reflow before restoring scroll ratios. Use a timeout fallback.
      let done = false;
      const onMessage = (ev: MessageEvent) => {
        try {
          const d = ev?.data;
          if (!d || typeof d !== 'object') return;
          if (d.type === 'vivlio:reflowDone' || d.type === 'vivlio:spreadReady') {
            // both reflowDone and spreadReady indicate the iframe has (or is about
            // to have) stable layout for overlay/scroll calculations
            done = true;
            try {
              if (zoomChanged) {
                // center on the content center we computed earlier
                // Clamp to valid range to prevent negative scroll (which causes cutoff)
                if (wrapper.scrollWidth > wrapper.clientWidth) {
                  const maxLeft = Math.max(0, wrapper.scrollWidth - wrapper.clientWidth);
                  wrapper.scrollLeft = Math.max(0, Math.min(maxLeft, centerTargetLeft));
                } else {
                  wrapper.scrollLeft = 0;
                }
                if (wrapper.scrollHeight > wrapper.clientHeight) {
                  const maxTop = Math.max(0, wrapper.scrollHeight - wrapper.clientHeight);
                  wrapper.scrollTop = Math.max(0, Math.min(maxTop, centerTargetTop));
                } else {
                  wrapper.scrollTop = 0;
                }
              } else {
                if (wrapper.scrollWidth > wrapper.clientWidth) {
                  const maxLeft = Math.max(0, wrapper.scrollWidth - wrapper.clientWidth);
                  wrapper.scrollLeft = Math.max(0, Math.min(maxLeft, Math.round(prev.leftRatio * maxLeft)));
                } else {
                  wrapper.scrollLeft = 0;
                }
                if (wrapper.scrollHeight > wrapper.clientHeight) {
                  const maxTop = Math.max(0, wrapper.scrollHeight - wrapper.clientHeight);
                  wrapper.scrollTop = Math.max(0, Math.min(maxTop, Math.round(prev.topRatio * maxTop)));
                } else {
                  wrapper.scrollTop = 0;
                }
              }
            } catch (e) { /* ignore */ }
            // overlay will be updated via iframe polling/resize observers already set up
            window.removeEventListener('message', onMessage);
          }
        } catch (e) { /* ignore */ }
      };
      window.addEventListener('message', onMessage);
      // fallback: if no ack within 300ms, restore anyway
      window.setTimeout(() => {
        if (!done) {
          try {
            if (zoomChanged) {
              if (wrapper.scrollWidth > wrapper.clientWidth) {
                const maxLeft = Math.max(0, wrapper.scrollWidth - wrapper.clientWidth);
                wrapper.scrollLeft = Math.max(0, Math.min(maxLeft, centerTargetLeft));
              } else {
                wrapper.scrollLeft = 0;
              }
              if (wrapper.scrollHeight > wrapper.clientHeight) {
                const maxTop = Math.max(0, wrapper.scrollHeight - wrapper.clientHeight);
                wrapper.scrollTop = Math.max(0, Math.min(maxTop, centerTargetTop));
              } else {
                wrapper.scrollTop = 0;
              }
            } else {
              if (wrapper.scrollWidth > wrapper.clientWidth) {
                const maxLeft = Math.max(0, wrapper.scrollWidth - wrapper.clientWidth);
                wrapper.scrollLeft = Math.max(0, Math.min(maxLeft, Math.round(prev.leftRatio * maxLeft)));
              } else {
                wrapper.scrollLeft = 0;
              }
              if (wrapper.scrollHeight > wrapper.clientHeight) {
                const maxTop = Math.max(0, wrapper.scrollHeight - wrapper.clientHeight);
                wrapper.scrollTop = Math.max(0, Math.min(maxTop, Math.round(prev.topRatio * maxTop)));
              } else {
                wrapper.scrollTop = 0;
              }
            }
          } catch (e) { /* ignore */ }
          try { window.removeEventListener('message', onMessage); } catch (e) { /* ignore */ }
        }
      }, 300);
    // update lastZoomRef for next invocation
    lastZoomRef.current = zoom;
    } catch (e) {
      // ignore measurement failures
      console.warn('[VivlioDBG] iframe measurement failed', e);
    }
  }, [zoom, portalContainer, page]);  // Remove pageViewMode from dependencies

  // Ensure when pageViewMode changes we request a reflow in iframe so styles and page layout update
  useEffect(() => {
    const iframe = iframeRef.current;
    if (!iframe) return;
    try {
      // dispatch resize and ask iframe to reflow/recompute layout.
      // Wait for two animation frames so React has applied the portal
      // updates inside the iframe and the renderer DOM reflects the
      // new pageViewMode. This reduces races where reflow is requested
      // before pagination/layout completes.
      iframe.contentWindow?.dispatchEvent(new Event('resize'));
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          try {
            iframe.contentWindow?.postMessage({ type: 'vivlio:requestReflow', reason: 'modeChange' }, '*');
          } catch (e) { /* ignore */ }
        });
      });
      // overlay will update via iframe's resize listeners / polling after reflow
    } catch (e) { /* ignore */ }
  }, [pageViewMode]);

  // Adjust wrapper styles based on zoom to enable proper scrolling
  useEffect(() => {
    const wrapper = wrapperRef.current;
    if (!wrapper) return;
    try {
      // always allow both axes to scroll on the wrapper; inner document may hide its own scrollbars
      wrapper.style.overflow = 'auto';
      wrapper.style.overflowX = 'auto';
      wrapper.style.overflowY = 'auto';
      if (zoom >= 1) {
        // For zoom >= 1, allow scrolling by removing flex centering
        wrapper.style.display = 'block';
        wrapper.style.alignItems = '';
        wrapper.style.justifyContent = '';
        // do not forcibly reset scroll here; scroll restoration is handled by
        // the zoom measurement effect which preserves/restores scroll ratios
        // after the iframe reflow acknowledgement.
      } else {
        // For zoom < 1, center the content
        wrapper.style.display = 'flex';
        wrapper.style.alignItems = 'center';
        wrapper.style.justifyContent = 'center';
      }
    } catch (e) {
      /* ignore */
    }
  }, [zoom]);

  if (!payload || !sourceUrl) {
    return <div>Loading...</div>;
  }

  return (
    <div
      ref={wrapperRef}
      className="vivlio-viewer-wrapper"
      data-reading-direction={readingDirection}
      style={{ position: 'relative' }}
    >
      <div ref={spacerRef} style={{ width: '100%', height: '100%', position: 'relative' }}>
        <iframe
          ref={iframeRef}
          className="vivlio-iframe"
          // avoid remounting iframe on Single/Spread toggle by not including pageViewMode in the key
          key={`${(payload.html || '')}_${readingDirection}_portal`}
          srcDoc={buildShell(gutterColor)}
          title="Vivliostyle Preview (isolated)"
          onLoad={handleIframeLoad}
          style={{ pointerEvents: showRaw ? 'none' : 'auto', visibility: showRaw ? 'hidden' : 'visible', position: 'absolute', left: 0, top: 0 }}
        />
      </div>
      {portalContainer && createPortal(
        <div
          className="vivlio-portal"
          style={{ width: '100%', height: '100%', pointerEvents: showRaw ? 'none' : 'auto', visibility: showRaw ? 'hidden' : 'visible' }}
        >
          <Renderer
            key={`renderer_${sourceUrl}_${readingDirection}`}
            source={sourceUrl}
            page={page}
            pageViewMode={pageViewMode}
            style={{ width: '100%', height: '100%' }}
            onLoad={onRendererLoad}
            onNavigation={onRendererNavigation}
          />
        </div>,
        portalContainer
      )}
      {showRaw && (
        <div className="vivlio-raw-overlay">
          <iframe
            className="vivlio-raw-frame"
            key={(payload.html || '') + '_' + readingDirection + '_' + pageViewMode + '_raw'}
            srcDoc={payload.html || ''}
            title="Vivliostyle Raw HTML"
          />
        </div>
      )}
    </div>
  );
};

function buildShell(gutterColor: string) {
  return `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Vivlio Preview</title><style>
    :root{ --vivlio-bg: ${gutterColor}; }
    html,body{height:100%;margin:0;padding:0;background:var(--vivlio-bg)}
    #vivlio-root{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:0;margin:0;box-sizing:border-box}
  </style></head><body><div id="vivlio-root"></div>
  <script>
    // Listen for host requests to reflow layout. We perform a resize event dispatch and
    // a tiny style toggle to force reflow so the vivliostyle renderer recalculates page layout.
    window.addEventListener('message', (ev) => {
      try {
        const d = ev && ev.data;
        if (!d || typeof d !== 'object') return;
        if (d.type === 'vivlio:requestReflow') {
          // small visual nudge to ensure layout
          try { document.documentElement.style.willChange = 'transform'; } catch(e){}
          setTimeout(() => {
            try { window.dispatchEvent(new Event('resize')); } catch(e){}
            try { document.documentElement.style.willChange = ''; } catch(e){}
            // notify host that we've attempted reflow
            try { parent.postMessage({ type: 'vivlio:reflowDone' }, '*'); } catch(e){}
            // also send a spread-ready signal a bit later; the renderer may need
            // a short extra time to finish pagination/layout for spread mode
            setTimeout(() => {
              try { parent.postMessage({ type: 'vivlio:spreadReady' }, '*'); } catch(e){}
            }, 80);
          }, 30);
        }
      } catch (e) { /* ignore */ }
    }, false);
  </script>
  </body></html>`;
}

function useIframeOverlay(portalContainer: HTMLElement | null, page: number, readingDirection: 'ltr' | 'rtl', pageViewMode: PageViewMode, zoom: number, iframeRef: React.RefObject<HTMLIFrameElement | null>) {
  const overlayRef = useRef<HTMLElement | null>(null);
  const iframeStyleRef = useRef<HTMLStyleElement | null>(null);
  const roRef = useRef<ResizeObserver | null>(null);
  const listenersAttachedRef = useRef(false);
  const transparentAppliedRef = useRef<HTMLElement[] | null>(null);
  const updateOverlayRef = useRef<(() => void) | null>(null);

  useEffect(() => {
    let currentWin: Window | null = null;
    let cancelPolling: (() => void) | null = null;
    let currentUpdate: (() => void) | null = null;

    const cleanup = () => {
      try {
        if (cancelPolling) {
          try { cancelPolling(); } catch (e) { /* ignore */ }
          cancelPolling = null;
        }
        if (roRef.current) {
          try { roRef.current.disconnect(); } catch (e) { /* ignore */ }
          roRef.current = null;
        }
        if (overlayRef.current && overlayRef.current.parentElement) {
          overlayRef.current.parentElement.removeChild(overlayRef.current);
          overlayRef.current = null;
        }
        if (iframeStyleRef.current && iframeStyleRef.current.parentElement) {
          iframeStyleRef.current.parentElement.removeChild(iframeStyleRef.current);
          iframeStyleRef.current = null;
        }
        if (listenersAttachedRef.current && currentWin && currentUpdate) {
          try { currentWin.removeEventListener('scroll', currentUpdate, true); } catch (e) { /* ignore */ }
          try { currentWin.removeEventListener('resize', currentUpdate); } catch (e) { /* ignore */ }
          listenersAttachedRef.current = false;
        }
        if (transparentAppliedRef.current) {
          try { transparentAppliedRef.current.forEach((el) => el.classList.remove('vivlio--ancestor-transparent')); } catch (e) { /* ignore */ }
          transparentAppliedRef.current = null;
        }
      } catch (e) { /* ignore */ }
      updateOverlayRef.current = null;
      currentUpdate = null;
    };

    if (!portalContainer) {
      cleanup();
      return () => {};
    }

    const doc = portalContainer.ownerDocument as Document | null;
    const win = doc?.defaultView ?? null;
    currentWin = win;
    if (!doc) {
      cleanup();
      return () => {};
    }

    try {
      let styleEl = doc.getElementById('vivlio-isolation-style') as HTMLStyleElement | null;
      if (!styleEl) {
        styleEl = doc.createElement('style');
        styleEl.id = 'vivlio-isolation-style';
        doc.head.appendChild(styleEl);
      }
      // base isolation + overlay styles. We include a placeholder for zoom rules which will be updated below.
      let cssContent = `
        .vivlio--ancestor-transparent{ background: transparent !important; overflow: visible !important }
        #vivlio-bleed-shadow{ position:absolute; pointer-events:none; z-index:1050; transition:opacity .18s; opacity:0.98; border-radius:6px }
        /* zoom-target styles - runtime-updated */
        #vivlio-root { transition: transform 120ms ease; transform-origin: center center; }
      `;
      if (pageViewMode === PageViewMode.SPREAD && readingDirection === 'rtl') {
        cssContent += `
          [data-vivliostyle-spread-container] { flex-direction: row-reverse; }
        `;
      }
      styleEl.textContent = cssContent;
      iframeStyleRef.current = styleEl;

      // Ensure iframe is full size inside the wrapper; inner content zoom will be injected into the iframe doc below
      const iframe = iframeRef.current;
      if (iframe) {
        iframe.style.width = '100%';
        iframe.style.height = '100%';
      }

      // Inject or update a runtime style that scales the inner vivlio-root element so the actual preview content scales.
      try {
        const rootStyleId = 'vivlio-zoom-style';
        let rootStyle = doc.getElementById(rootStyleId) as HTMLStyleElement | null;
        if (!rootStyle) {
          rootStyle = doc.createElement('style');
          rootStyle.id = rootStyleId;
          doc.head.appendChild(rootStyle);
        }
        // Strategy:
        // - When zoom >= 1 we want the visual content to be larger but avoid inner scrollbars.
        //   So we apply no inner transform, enlarge the iframe, and let the wrapper handle scrolling.
        // - When zoom < 1 we scale the inner root to zoom in the iframe.
  // Force inner root to no scale; host handles visual scaling via iframe transform
  rootStyle.textContent = `#vivlio-root { transform: none !important; transform-origin: top left !important; width:100%; height:100%; padding:0 !important; margin:0 !important; }`;

                try {
                  // Hide inner scrollbars always; host wrapper will manage scrolling.
                  if (doc.documentElement) doc.documentElement.style.overflow = 'hidden';
                  if (doc.body) doc.body.style.overflow = 'hidden';
                } catch (e) {
                  // ignore
                }

                // Force a resize event in the iframe so vivliostyle renderer recomputes layout
                try {
                  win?.dispatchEvent(new Event('resize'));
                } catch (e) { /* ignore */ }
      } catch (e) {
        // ignore injection failures
      }
    } catch (e) {
      console.warn('[VivlioDBG] inject style failed', e);
    }

    try {
      let overlay = doc.getElementById('vivlio-bleed-shadow') as HTMLElement | null;
      if (!overlay) {
        overlay = doc.createElement('div');
        overlay.id = 'vivlio-bleed-shadow';
        doc.body.appendChild(overlay);
      }
      overlayRef.current = overlay;
    } catch (e) {
      console.warn('[VivlioDBG] create overlay failed', e);
    }

    const getSpread = (): HTMLElement | null => {
      try {
        return doc.querySelector('[data-vivliostyle-spread-container], [data-vivliostyle-page-container], .page') as HTMLElement | null;
      } catch (e) {
        return null;
      }
    };

    const applyAncestorTransparency = (spread: HTMLElement | null) => {
      try {
        if (!spread) return;
        if (transparentAppliedRef.current) {
          try { transparentAppliedRef.current.forEach((el) => el.classList.remove('vivlio--ancestor-transparent')); } catch (e) { /* ignore */ }
        }
        const list: HTMLElement[] = [];
        let cursor: HTMLElement | null = spread.parentElement;
        while (cursor && cursor !== doc.documentElement) {
          const current = cursor;
          try {
            const styles = (doc.defaultView?.getComputedStyle(current) as CSSStyleDeclaration) || window.getComputedStyle(current);
            if (!styles) {
              cursor = current.parentElement;
              continue;
            }
            const hasBackground = styles.backgroundColor && styles.backgroundColor !== 'rgba(0, 0, 0, 0)' && styles.backgroundColor !== 'transparent';
            const hidesOverflow = styles.overflow === 'hidden';
            const hasTransform = styles.transform && styles.transform !== 'none';
            if (hasBackground || hidesOverflow || hasTransform) {
              current.classList.add('vivlio--ancestor-transparent');
              list.push(current);
            }
          } catch (e) { /* ignore */ }
          cursor = current.parentElement;
        }
        transparentAppliedRef.current = list;
      } catch (e) { /* ignore */ }
    };

    const updateOverlay = () => {
      try {
        const overlay = overlayRef.current;
        const spread = getSpread();
        if (!overlay) return;
        if (!spread) {
          overlay.style.opacity = '0';
          return;
        }
        applyAncestorTransparency(spread);
        const rect = spread.getBoundingClientRect();
        const left = rect.left + (win?.scrollX || 0);
        const top = rect.top + (win?.scrollY || 0);
        overlay.style.left = `${Math.max(0, left)}px`;
        overlay.style.top = `${Math.max(0, top)}px`;
        overlay.style.width = `${Math.max(0, rect.width)}px`;
        overlay.style.height = `${Math.max(0, rect.height)}px`;
        overlay.style.opacity = '0.98';
      } catch (e) {
        console.warn('[VivlioDBG] updateOverlay error', e);
      }
    };

    currentUpdate = updateOverlay;
    updateOverlayRef.current = updateOverlay;

    const startPolling = () => {
      let attempts = 0;
      const maxAttempts = 30;
      const pollInterval = 200;
      const handle = window.setInterval(() => {
        attempts += 1;
        const spread = getSpread();
        if (spread) {
          try {
            if ('ResizeObserver' in window) {
              const ro = new ResizeObserver(updateOverlay);
              try { ro.observe(spread); } catch (err) { ro.disconnect(); }
              roRef.current = ro;
            }
            if (win && !listenersAttachedRef.current) {
              try { win.addEventListener('scroll', updateOverlay, true); } catch (err) { /* ignore */ }
              try { win.addEventListener('resize', updateOverlay); } catch (err) { /* ignore */ }
              listenersAttachedRef.current = true;
            }
            setTimeout(updateOverlay, 80);
          } catch (err) {
            console.warn('[VivlioDBG] setup observers failed', err);
          }
          window.clearInterval(handle);
        } else if (attempts >= maxAttempts) {
          window.clearInterval(handle);
        }
      }, pollInterval);
      return () => window.clearInterval(handle);
    };

    cancelPolling = startPolling();

    return () => {
      cleanup();
    };
  }, [portalContainer, pageViewMode, readingDirection, zoom]);

  useEffect(() => {
    updateOverlayRef.current?.();
  }, [page]);

  // ensure overlay is updated when portal container or zoom changes
  useEffect(() => {
    updateOverlayRef.current?.();
  }, [portalContainer, zoom, pageViewMode]);
}








